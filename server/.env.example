PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Multi-Model Consensus AI Keys (OpenAI & Anthropic)
# When provided, Solace runs live GPT-4o and Claude 3.5 Sonnet audits in parallel with Gemini.
# If omitted, Solace automatically runs high-fidelity Soroban AST simulation previews for cross-model consensus.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stellar Network & Soroban Configuration
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed Solace Smart Contract ID
SOLACE_CONTRACT_ID=C...

# Auditor Keypair (Secret Key for signing record_audit transactions)
AUDITOR_SECRET_KEY=S...
